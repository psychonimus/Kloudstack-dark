{
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/enquiry"
    },
    {
      "source": "/api/",
      "destination": "/api/enquiry"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
